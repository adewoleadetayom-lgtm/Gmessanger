      </main>

      <div class="gm-composer">
        <button class="gm-icon">☺</button>
        <input id="gmGemmaInput" placeholder="Message Gemma"
          onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendGemma()}">
        <button class="gm-icon">📎</button>
        <button class="gm-send" onclick="sendGemma()">➤</button>
      </div>
    `;
  }

  const settings=$("settingsScreen");
  if(settings){
    settings.className="screen gm-v2";
    settings.innerHTML=`
      <header class="gm-v2-header">
        <button class="gm-icon" onclick="gmNav('chats')">‹</button>
        <div class="gm-section-title" style="margin:0">Settings</div>
        <div></div>
      </header>

      <main class="gm-scroll">
        <section class="gm-section">
          <div class="gm-settings-card">
            <div class="gm-v2-brand">
              <div class="gm-logo">G</div>
              <div>
                <strong>${escapeHtml(localStorage.getItem("gmName")||"G Messenger User")}</strong>
                <div style="color:#707980;font-size:14px">G Messenger account</div>
              </div>
            </div>
          </div>

          ${[
            ["Account","Profile, phone number and account settings"],
            ["Privacy","Privacy controls and blocked contacts"],
            ["Security","Security and verification"],
            ["Notifications","Message and call notifications"],
            ["Chats","Chat appearance and history"],
            ["Storage and data","Network and data usage"],
            ["Linked devices","Manage connected devices"],
            ["Help","Help centre and support"]
          ].map(x=>`
            <div class="gm-settings-row" onclick="alert('${x[0]}')">
              <div>
                <strong>${x[0]}</strong>
                <div style="color:#707980;font-size:14px;margin-top:3px">${x[1]}</div>
              </div>
              <span>›</span>
            </div>
          `).join("")}
        </section>
      </main>
    `;
  }

  let overlay=document.getElementById("gmChatOverlay");
  if(!overlay){
    overlay=document.createElement("section");
    overlay.id="gmChatOverlay";
    overlay.className="gm-overlay";
    document.body.appendChild(overlay);
  }

  let menu=document.getElementById("gmGlobalMenu");
  if(!menu){
    menu=document.createElement("div");
    menu.id="gmGlobalMenu";
    menu.className="gm-menu";
    menu.innerHTML=`
      <button onclick="gmNewGroup()">New group</button>
      <button onclick="gmBroadcast()">New broadcast</button>
      <button onclick="alert('Linked devices')">Linked devices</button>
      <button onclick="gmStarred()">Starred messages</button>
      <button onclick="gmReadAll()">Read all</button>
      <button onclick="gmNav('settings')">Settings</button>
    `;
    document.body.appendChild(menu);
  }

  renderChats();
}

function bottomNav(active){
  return `
    <nav class="gm-bottom">
      <button data-nav="chats" class="${active==="chats"?"active":""}"
        onclick="gmNav('chats')">
        <span class="nav-icon">💬</span>
        <span>Chats</span>
      </button>

      <button data-nav="updates" class="${active==="updates"?"active":""}"
        onclick="gmNav('updates')">
        <span class="nav-icon">◉</span>
        <span>Updates</span>
      </button>

      <button data-nav="communities" class="${active==="communities"?"active":""}"
        onclick="gmNav('communities')">
        <span class="nav-icon">👥</span>
        <span>Communities</span>
      </button>

      <button data-nav="calls" class="${active==="calls"?"active":""}"
        onclick="gmNav('calls')">
        <span class="nav-icon">☎</span>
        <span>Calls</span>
      </button>
    </nav>
  `;
}

window.gmToggleMenu=function(){
  const m=$("gmGlobalMenu");
  if(m)m.classList.toggle("show");
};

document.addEventListener("click",function(e){
  const m=$("gmGlobalMenu");
  if(!m)return;
  if(!e.target.closest("#gmGlobalMenu") &&
     !e.target.closest(".gm-icon")){
    m.classList.remove("show");
  }
});

window.gmNewChat=function(){
  const name=prompt("Enter contact name");
  if(!name)return;

  chats.unshift({
    name:name.trim(),
    preview:"New conversation",
    time:"Now"
  });

  renderChats();
};

window.gmNewGroup=function(){
  $("gmGlobalMenu")?.classList.remove("show");
  const name=prompt("Enter group name");
  if(!name)return;

  chats.unshift({
    name:name.trim(),
    preview:"New group created",
    time:"Now",
    group:true
  });

  gmNav("chats");
  renderChats();
};

window.gmBroadcast=function(){
  $("gmGlobalMenu")?.classList.remove("show");
  alert("Broadcast creation is ready for contact selection.");
};

window.gmStarred=function(){
  $("gmGlobalMenu")?.classList.remove("show");
  alert("Starred messages will appear here.");
};

window.gmReadAll=function(){
  chats.forEach(c=>delete c.unread);
  $("gmGlobalMenu")?.classList.remove("show");
  renderChats();
};

window.gmNewCommunity=function(){
  const name=prompt("Enter community name");
  if(!name)return;
  communities.unshift([name.trim(),"New G Messenger community"]);
  buildScreens();
  gmNav("communities");
};

window.gmNav=gmNav;
window.renderChats=renderChats;
window.gmOpenChat=gmOpenChat;
window.gmCloseChat=gmCloseChat;
window.gmSendMessage=gmSendMessage;

window.enterMessenger=function(){
  const input=$("loginName");
  const name=input?.value.trim()||"G Messenger User";
  localStorage.setItem("gmName",name);
  gmShow("appScreen");
  document.querySelectorAll(".gm-bottom button").forEach(b=>{
    b.classList.toggle("active",b.dataset.nav==="chats");
  });
};

document.addEventListener("DOMContentLoaded",function(){
  buildScreens();
});

})();

</script>
</body>
</html>
