<title>G Messenger</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

html,body{
  margin:0;
  padding:0;
  width:100%;
  height:100%;
  font-family:Arial,Helvetica,sans-serif;
  background:#fff;
  color:#111;
}

button,input,textarea{
  font:inherit;
}

button{
  border:0;
  background:none;
  cursor:pointer;
}

.screen{
  display:none;
  width:100%;
  height:100dvh;
}

.screen.active{
  display:flex;
}

/* ================= LOGIN ================= */

#loginScreen{
  align-items:center;
  justify-content:center;
  padding:24px;
}

.login-box{
  width:100%;
  max-width:420px;
  text-align:center;
}

.logo{
  width:82px;
  height:82px;
  margin:0 auto 20px;
  border-radius:24px;
  background:#087cff;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:42px;
  font-weight:800;
}

.login-box h1{
  margin:0 0 8px;
  font-size:30px;
}

.login-box p{
  color:#667781;
  margin:0 0 28px;
}

.login-input{
  width:100%;
  padding:15px;
  border:1px solid #d7dce1;
  border-radius:14px;
  outline:none;
  margin-bottom:12px;
}

.primary-btn{
  width:100%;
  padding:15px;
  border-radius:14px;
  background:#087cff;
  color:#fff;
  font-weight:700;
}

/* ================= APP ================= */

#appScreen{
  position:relative;
  flex-direction:column;
  overflow:hidden;
  background:#fff;
}

.app-header{
  flex:0 0 auto;
  padding:18px 18px 10px;
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.brand{
  display:flex;
  align-items:center;
  gap:10px;
  color:#087cff;
}

.brand-mark{
  width:38px;
  height:38px;
  border-radius:12px;
  background:#087cff;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  font-size:21px;
}

.brand-name{
  font-size:22px;
  font-weight:800;
}

.header-buttons{
  display:flex;
  gap:6px;
}

.icon-button{
  width:42px;
  height:42px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:23px;
}

.icon-button:active{
  background:#eef5ff;
}

.search-box{
  margin:4px 16px 12px;
  height:48px;
  border-radius:16px;
  background:#f1f4f7;
  display:flex;
  align-items:center;
  padding:0 15px;
  gap:10px;
}

.search-box span{
  font-size:21px;
  color:#667781;
}

.search-box input{
  border:0;
  outline:0;
  background:transparent;
  width:100%;
  font-size:15px;
}

.filter-row{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:0 16px 12px;
  scrollbar-width:none;
}

.filter-row::-webkit-scrollbar{
  display:none;
}

.filter{
  flex:0 0 auto;
  padding:9px 15px;
  border-radius:20px;
  background:#f1f4f7;
  color:#445;
  font-size:13px;
}

.filter.active{
  background:#087cff;
  color:#fff;
}

.chat-list{
  flex:1;
  min-height:0;
  overflow-y:auto;
  padding-bottom:90px;
}

.chat-item{
  display:flex;
  align-items:center;
  gap:13px;
  padding:13px 17px;
  min-height:76px;
}

.chat-item:active{
  background:#f5f7f9;
}

.avatar{
  flex:0 0 52px;
  width:52px;
  height:52px;
  border-radius:50%;
  background:#087cff;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:20px;
  font-weight:700;
}

.chat-content{
  min-width:0;
  flex:1;
}

.chat-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
}

.chat-name{
  font-weight:700;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.chat-time{
  color:#667781;
  font-size:12px;
  flex:0 0 auto;
}

.chat-preview{
  color:#667781;
  font-size:14px;
  margin-top:5px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.gemma-item .avatar{
  background:#fff;
  color:#087cff;
  border:2px solid #087cff;
}

.ai-label{
  display:inline-block;
  margin-left:5px;
  font-size:10px;
  background:#e7f1ff;
  color:#087cff;
  padding:3px 6px;
  border-radius:7px;
  vertical-align:middle;
}

.fab{
  position:absolute;
  right:18px;
  bottom:82px;
  width:58px;
  height:58px;
  border-radius:18px;
  background:#087cff;
  color:#fff;
  font-size:28px;
  box-shadow:0 6px 20px rgba(0,0,0,.18);
  z-index:10;
}

.bottom-nav{
  position:absolute;
  left:0;
  right:0;
  bottom:0;
  height:72px;
  padding-bottom:env(safe-area-inset-bottom);
  background:#fff;
  border-top:1px solid #e7eaed;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  z-index:9;
}

.nav-item{
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4px;
  color:#667781;
  font-size:11px;
}

.nav-item.active{
  color:#087cff;
  font-weight:700;
}

.nav-icon{
  font-size:22px;
}

/* ================= OTHER SCREENS ================= */

.full-screen{
  flex-direction:column;
  background:#fff;
}

.screen-header{
  height:64px;
  flex:0 0 auto;
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 16px;
  border-bottom:1px solid #e7eaed;
}

.screen-header h2{
  margin:0;
  font-size:20px;
}

.back-btn{
  font-size:25px;
  width:40px;
  height:40px;
}

.empty-screen{
  flex:1;
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  padding:30px;
  text-align:center;
  color:#667781;
}

.empty-icon{
  font-size:52px;
  margin-bottom:15px;
}

.empty-screen h3{
  color:#111;
  margin:0 0 8px;
}

/* ================= GEMMA ================= */

#gemmaScreen{
  flex-direction:column;
  background:#f7f9fb;
}

.gemma-header{
  flex:0 0 auto;
  height:66px;
  display:flex;
  align-items:center;
  gap:10px;
  padding:0 12px;
  background:#087cff;
  color:#fff;
}

.gemma-avatar{
  width:42px;
  height:42px;
  border-radius:50%;
  background:#fff;
  color:#087cff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:800;
  font-size:19px;
}

.gemma-title{
  flex:1;
}

.gemma-title strong{
  display:block;
  font-size:16px;
}

.gemma-title small{
  opacity:.85;
}

.gemma-messages{
  flex:1;
  overflow-y:auto;
  padding:24px 16px 20px;
}

.welcome-card{
  max-width:430px;
  margin:20px auto;
  background:#fff;
  border-radius:18px;
  padding:24px;
  box-shadow:0 2px 10px rgba(0,0,0,.06);
}

.welcome-card h2{
  color:#087cff;
  margin-top:0;
}

.welcome-card p{
  color:#667781;
  line-height:1.5;
}

.gemma-composer{
  flex:0 0 auto;
  display:flex;
  gap:8px;
  padding:10px;
  background:#fff;
  border-top:1px solid #e7eaed;
}

.gemma-composer textarea{
  flex:1;
  resize:none;
  max-height:110px;
  border:1px solid #d7dce1;
  border-radius:20px;
  padding:11px 15px;
  outline:none;
}

.send-btn{
  width:46px;
  height:46px;
  border-radius:50%;
  background:#087cff;
  color:#fff;
  font-size:19px;
}

/* ================= DESKTOP ================= */

@media(min-width:700px){
  #appScreen,
  .full-screen,
  #gemmaScreen{
    max-width:700px;
    margin:auto;
    border-left:1px solid #e5e5e5;
    border-right:1px solid #e5e5e5;
  }

  body{
    background:#eef1f4;
  }
}
</style>
