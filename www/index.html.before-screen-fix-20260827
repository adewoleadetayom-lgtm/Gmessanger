<script>
const chats = [
  {
    name:"Gemma",
    preview:"Your G Messenger AI assistant",
    time:"Now",
    initial:"G",
    type:"gemma",
    unread:false,
    favorite:true,
    group:false
  },
  {
    name:"G Messenger",
    preview:"Welcome to G Messenger",
    time:"Now",
    initial:"G",
    unread:false,
    favorite:true,
    group:false
  }
];

let currentFilter = "all";


function showScreen(id){
  document.querySelectorAll(".screen").forEach(screen=>{
    screen.classList.remove("active");
  });

  const target = document.getElementById(id);

  if(target){
    target.classList.add("active");
  }
}


function goHome(button){
  showScreen("appScreen");

  if(button){
    document.querySelectorAll(".nav-item").forEach(x=>{
      x.classList.remove("active");
    });

    button.classList.add("active");
  }
}


function showSection(id,button){
  showScreen(id);

  document.querySelectorAll(".nav-item").forEach(x=>{
    x.classList.remove("active");
  });

  if(button){
    button.classList.add("active");
  }
}


function enterMessenger(){
  const name = document.getElementById("loginName").value.trim();

  if(name){
    localStorage.setItem("gmessengerName",name);
  }

  showScreen("appScreen");
  renderChats();
}


function renderChats(){

  const list = document.getElementById("chatList");

  if(!list) return;

  const query =
    (document.getElementById("chatSearch")?.value || "")
      .trim()
      .toLowerCase();

  let filtered = chats.filter(chat=>{

    if(currentFilter === "unread" && !chat.unread){
      return false;
    }

    if(currentFilter === "favorites" && !chat.favorite){
      return false;
    }

    if(currentFilter === "groups" && !chat.group){
      return false;
    }

    if(query){
      return (
        chat.name.toLowerCase().includes(query) ||
        chat.preview.toLowerCase().includes(query)
      );
    }

    return true;
  });

  list.innerHTML = "";

  if(!filtered.length){
    list.innerHTML = `
      <div class="empty-screen">
        <div class="empty-icon">⌕</div>
        <h3>No chats found</h3>
        <p>Try another search or start a new chat.</p>
      </div>
    `;
    return;
  }

  filtered.forEach(chat=>{

    const item = document.createElement("div");

    item.className =
      "chat-item " +
      (chat.type === "gemma" ? "gemma-item" : "");

    item.onclick =
      chat.type === "gemma"
      ? openGemma
      : ()=>openChat(chat.name);

    item.innerHTML = `
      <div class="avatar">${escapeHtml(chat.initial)}</div>

      <div class="chat-content">

        <div class="chat-top">

          <div class="chat-name">
            ${escapeHtml(chat.name)}
            ${
              chat.type === "gemma"
              ? '<span class="ai-label">AI</span>'
              : ''
            }
          </div>

          <div class="chat-time">
            ${escapeHtml(chat.time)}
          </div>

        </div>

        <div class="chat-preview">
          ${escapeHtml(chat.preview)}
        </div>

      </div>
    `;

    list.appendChild(item);
  });
}


function escapeHtml(value){
  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");
}


function setFilter(filter,button){

  currentFilter = filter;

  document.querySelectorAll(".filter").forEach(x=>{
    x.classList.remove("active");
  });

  button.classList.add("active");

  renderChats();
}


function openGemma(){
  showScreen("gemmaScreen");
}


function sendGemma(){

  const input =
    document.getElementById("gemmaInput");

  const messages =
    document.getElementById("gemmaMessages");

  if(!input || !messages) return;

  const text = input.value.trim();

  if(!text) return;

  const userMessage =
    document.createElement("div");

  userMessage.style.cssText =
    "max-width:80%;margin:10px 0 10px auto;background:#087cff;color:#fff;padding:11px 14px;border-radius:16px 16px 4px 16px;";

  userMessage.textContent = text;

  messages.appendChild(userMessage);

  input.value = "";

  const reply =
    document.createElement("div");

  reply.style.cssText =
    "max-width:80%;margin:10px auto 10px 0;background:#fff;color:#111;padding:11px 14px;border-radius:16px 16px 16px 4px;box-shadow:0 1px 4px rgba(0,0,0,.08);";

  reply.textContent =
    "Gemma AI connection will be enabled in the next stage.";

  messages.appendChild(reply);

  messages.scrollTop = messages.scrollHeight;
}


function openChat(name){

  alert(
    name +
    " chat screen will be connected in the next chat stage."
  );
}


function newChat(){

  alert(
    "New chat will be connected in the next stage."
  );
}


document.addEventListener("DOMContentLoaded",()=>{

  const savedName =
    localStorage.getItem("gmessengerName");

  if(savedName){
    showScreen("appScreen");
  }

  renderChats();
});
</script>

