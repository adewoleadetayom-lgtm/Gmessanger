<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>G Messenger</title>

<style>
*{box-sizing:border-box}
html,body{margin:0;width:100%;height:100%;font-family:Arial,sans-serif;background:#fff;color:#102033}
button,input,textarea{font:inherit}
button{border:0;cursor:pointer}

.screen{display:none;width:100%;height:100vh}
.screen.active{display:flex}

.login{align-items:center;justify-content:center;padding:25px;background:#f5f9ff}
.card{width:min(430px,100%);background:#fff;border-radius:24px;padding:30px;box-shadow:0 10px 40px #00000015;text-align:center}
.logo{width:78px;height:78px;border-radius:50%;background:#087cff;color:#fff;display:flex;align-items:center;justify-content:center;font-size:38px;font-weight:bold;margin:0 auto 18px}
h1{margin:8px 0;font-size:27px}
.sub{color:#667781;line-height:1.5;margin-bottom:25px}
.field{text-align:left;margin:15px 0}
.field label{display:block;font-weight:bold;font-size:13px;margin-bottom:7px}
.field input{width:100%;padding:14px;border:1px solid #d8e1eb;border-radius:12px;outline:none}
.field input:focus{border-color:#087cff}
.primary{width:100%;padding:14px;border-radius:12px;background:#087cff;color:#fff;font-weight:bold;margin-top:8px}
.secondary{width:100%;padding:13px;border-radius:12px;background:#eef5ff;color:#087cff;margin-top:10px}

.app{flex-direction:column;background:#fff}
.header{background:#087cff;color:white;padding:18px 18px 14px}
.header-row{display:flex;justify-content:space-between;align-items:center}
.title{font-size:23px;font-weight:bold}
.icon{background:transparent;color:#fff;font-size:25px}
.search{margin-top:15px;width:100%;padding:13px 16px;border:0;border-radius:14px;outline:none}
.filters{display:flex;gap:8px;padding:10px 14px;border-bottom:1px solid #edf0f3}
.filter{padding:8px 13px;border-radius:20px;background:#f0f4f8;color:#52606d}
.filter.active{background:#087cff;color:#fff}
.chat-list{flex:1;overflow-y:auto;padding-bottom:75px}
.chat{display:flex;align-items:center;padding:15px 17px;border-bottom:1px solid #eef1f4;gap:13px}
.chat:active{background:#f4f8fc}
.avatar{width:50px;height:50px;border-radius:50%;background:#087cff;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:bold;font-size:20px;flex:none}
.chat-info{flex:1;min-width:0}
.chat-name{font-weight:bold;font-size:16px}
.chat-preview{color:#667781;font-size:13px;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chat-right{font-size:12px;color:#8696a0}
.gemma{background:linear-gradient(135deg,#087cff,#005bea);color:white}
.gemma .chat-preview{color:#e8f2ff}
.empty{text-align:center;color:#8696a0;padding:45px 25px;line-height:1.6}

.bottom{position:fixed;bottom:0;left:0;right:0;height:66px;background:#fff;border-top:1px solid #e4e9ee;display:flex;justify-content:space-around;align-items:center}
.bottom button{background:none;color:#667781;font-size:12px}
.bottom button span{display:block;font-size:21px;margin-bottom:3px}
.bottom .active{color:#087cff}

.chat-screen{flex-direction:column;background:#f5f8fb}
.chat-header{height:65px;background:#087cff;color:white;display:flex;align-items:center;padding:8px 12px;gap:12px}
.back{background:none;color:white;font-size:25px}
.chat-contact{flex:1}
.chat-contact-name{font-weight:bold}
.chat-contact-status{font-size:12px;opacity:.85}
.messages{flex:1;overflow-y:auto;padding:15px}
.msg{max-width:78%;padding:10px 13px;border-radius:14px;margin:7px 0;line-height:1.4;word-wrap:break-word}
.msg.mine{margin-left:auto;background:#087cff;color:white;border-bottom-right-radius:4px}
.msg.theirs{margin-right:auto;background:white;border-bottom-left-radius:4px}
.composer{display:flex;gap:8px;padding:9px;background:white;border-top:1px solid #ddd}
.composer textarea{flex:1;resize:none;border:1px solid #dce3ea;border-radius:20px;padding:11px 14px;outline:none;max-height:110px}
.send{width:45px;height:45px;border-radius:50%;background:#087cff;color:white}

.gemma-screen{flex-direction:column;background:#f5f8fb}
.gemma-header{background:#087cff;color:#fff;height:65px;display:flex;align-items:center;padding:10px 13px;gap:12px}
.gemma-body{flex:1;overflow:auto;padding:16px}
.gemma-welcome{background:#fff;border-radius:18px;padding:20px;text-align:center}
.gemma-composer{display:flex;gap:8px;padding:9px;background:#fff}
.gemma-composer textarea{flex:1;border:1px solid #ddd;border-radius:20px;padding:11px;resize:none}
</style>
</head>

<body>

<!-- LOGIN -->
<section id="loginScreen" class="screen login">
<div class="card">
<div class="logo">G</div>
<h1>G Messenger</h1>
<div class="sub">Fast, private messaging and communication.</div>

<div class="field">
<label>Phone number</label>
<input id="phone" type="tel" placeholder="+234 800 000 0000">
</div>

<button class="primary" onclick="register()">Continue</button>
</div>
</section>

<!-- VERIFY -->
<section id="verificationScreen" class="screen login">
<div class="card">
<div class="logo">G</div>
<h1>Verify your number</h1>
<div class="sub">Enter the six-digit verification code.</div>

<div class="field">
<label>Verification code</label>
<input id="verificationCode" inputmode="numeric" maxlength="6" placeholder="123456">
</div>

<button class="primary" onclick="verify()">Verify</button>
<button class="secondary" onclick="show('loginScreen')">Change number</button>
</div>
</section>

<!-- PROFILE -->
<section id="profileScreen" class="screen login">
<div class="card">
<div class="logo">G</div>
<h1>Create your profile</h1>
<div class="sub">Choose the name and username people will see.</div>

<div class="field">
<label>Your name</label>
<input id="profileName" placeholder="Your name">
</div>

<div class="field">
<label>Username</label>
<input id="username" placeholder="@username">
</div>

<button class="primary" onclick="saveProfile()">Continue</button>
</div>
</section>

<!-- SECURITY -->
<section id="securityScreen" class="screen login">
<div class="card">
<div class="logo">G</div>
<h1>Two-Step Verification</h1>
<div class="sub">Create a six-digit security PIN.</div>

<div class="field">
<label>Security PIN</label>
<input id="securityPin" type="password" inputmode="numeric" maxlength="6" placeholder="123456">
</div>

<div class="field">
<label>Recovery email (optional)</label>
<input id="recoveryEmail" type="email" placeholder="you@example.com">
</div>

<button class="primary" onclick="finishSetup()">Finish setup</button>
</div>
</section>

<!-- HOME -->
<section id="appScreen" class="screen app">

<header class="header">
<div class="header-row">
<div class="title">G Messenger</div>
<button class="icon" onclick="logout()">⋮</button>
</div>
<input class="search" id="search" placeholder="Search G Messenger" oninput="filterChats()">
</header>

<div class="filters">
<button class="filter active">All</button>
<button class="filter">Unread</button>
<button class="filter">Groups</button>
<button class="filter">Favorites</button>
</div>

<main id="chatList" class="chat-list">

<div class="chat gemma" data-name="Gemma" onclick="openGemma()">
<div class="avatar" style="background:white;color:#087cff">G</div>
<div class="chat-info">
<div class="chat-name">Gemma <small>AI</small></div>
<div class="chat-preview">Your G Messenger AI assistant</div>
</div>
<div>›</div>
</div>

<div id="emptyChats" class="empty">
No conversations yet.<br>
Search for a registered user to start chatting.
</div>

</main>

<nav class="bottom">
<button class="active"><span>💬</span>Chats</button>
<button><span>◉</span>Updates</button>
<button><span>👥</span>Communities</button>
<button><span>📞</span>Calls</button>
</nav>
</section>

<!-- CHAT -->
<section id="chatScreen" class="screen chat-screen">

<header class="chat-header">
<button class="back" onclick="show('appScreen');loadConversations()">‹</button>
<div class="avatar" id="contactAvatar" style="width:42px;height:42px;background:white;color:#087cff">G</div>
<div class="chat-contact">
<div class="chat-contact-name" id="contactName">Chat</div>
<div class="chat-contact-status" id="contactStatus">online</div>
</div>
</header>

<main id="messages" class="messages"></main>

<div class="composer">
<textarea id="messageInput" rows="1" placeholder="Message" onkeydown="messageKey(event)" oninput="messageTyping()"></textarea>
<button class="send" onclick="sendMessage()">➤</button>
</div>
</section>

<!-- GEMMA -->
<section id="gemmaScreen" class="screen gemma-screen">

<header class="gemma-header">
<button class="back" onclick="show('appScreen')">‹</button>
<div class="avatar" style="width:42px;height:42px;background:white;color:#087cff">G</div>
<div class="chat-contact">
<div class="chat-contact-name">Gemma</div>
<div class="chat-contact-status">G Messenger AI</div>
</div>
</header>

<main class="gemma-body">
<div class="gemma-welcome">
<h2>Welcome to Gemma</h2>
<p>Your G Messenger AI assistant is ready.</p>
<p>Ask questions, get explanations, translate text, or get help with everyday tasks.</p>
</div>
</main>

<div class="gemma-composer">
<textarea id="gemmaInput" rows="1" placeholder="Message Gemma"></textarea>
<button class="send" onclick="sendGemma()">➤</button>
</div>
</section>

<script src="/socket.io/socket.io.js"></script>
<script>
let token=localStorage.getItem("gmessengerToken")||"";

let socket = null;

function connectRealtime(){
  if(!token) return;

  if(socket){
    try { socket.disconnect(); } catch(e){}
  }

  socket = io();

  socket.on('connect', () => {
    socket.emit('gm:authenticate', token);
  });

  socket.on('gm:user-online', ({userId}) => {
    if(currentConversation &&
       Number(currentConversation.user?.id) === Number(userId)){
      document.getElementById('contactStatus').textContent = 'online';
    }
  });

  socket.on('gm:user-offline', ({userId}) => {
    if(currentConversation &&
       Number(currentConversation.user?.id) === Number(userId)){
      document.getElementById('contactStatus').textContent = 'offline';
    }
  });

  socket.on('gm:typing', ({conversationId, userId, typing}) => {
    if(!currentConversation) return;
    if(Number(currentConversation.id) !== Number(conversationId)) return;
    if(Number(currentConversation.user?.id) !== Number(userId)) return;

    document.getElementById('contactStatus').textContent =
      typing ? 'typing…' : 'online';
  });

  socket.on('gm:new-message', ({conversationId, message}) => {
    if(!message) return;

    if(currentConversation &&
       Number(currentConversation.id) === Number(conversationId)) {

      const box = document.getElementById('messages');

      const div = document.createElement('div');
      div.className =
        'msg ' +
        (Number(message.sender_id) === Number(currentUser?.id)
          ? 'mine'
          : 'theirs');

      div.textContent = message.text;
      box.appendChild(div);
      box.scrollTop = box.scrollHeight;

    } else {
      loadConversations();
    }
  });
}

let currentPhone='';
let currentConversation=null;
let currentUser=null;

function show(id){
document.querySelectorAll('.screen').forEach(x=>x.classList.remove('active'));
const el=document.getElementById(id);
if(el)el.classList.add('active');
}

async function api(url,options={}){
options.headers=Object.assign({
'Content-Type':'application/json',
'Authorization':'Bearer '+token
},options.headers||{});

const r=await fetch(url,options);
const data=await r.json().catch(()=>({}));

if(!r.ok)throw new Error(data.error||'Request failed');
return data;
}

function startup(){
if(token){
connectRealtime();
show('appScreen');
loadConversations();
}else{
show('loginScreen');
}
}

async function register(){
currentPhone=document.getElementById('phone').value.trim();

if(currentPhone.length<7){
alert('Enter a valid phone number.');
return;
}

try{
await api('/api/auth/register',{
method:'POST',
headers:{Authorization:''},
body:JSON.stringify({phone:currentPhone})
});
show('verificationScreen');
}catch(e){
alert(e.message);
}
}

async function verify(){
const code=document.getElementById('verificationCode').value.trim();

if(!/^[0-9]{6}$/.test(code)){
alert('Enter the 6-digit verification code.');
return;
}

try{
const data=await api('/api/auth/verify',{
method:'POST',
headers:{Authorization:''},
body:JSON.stringify({phone:currentPhone,code})
});

token=data.token;
localStorage.setItem('gmessengerToken',token);
connectRealtime();

currentUser=data.user;

if(data.user.profileComplete){
localStorage.setItem('gmessengerName',data.user.name||'');
localStorage.setItem('gmessengerSetup','complete');
show('appScreen');
await loadConversations();
}else{
show('profileScreen');
}
}catch(e){
alert(e.message);
}
}

async function saveProfile(){
const name=document.getElementById('profileName').value.trim();
const username=document.getElementById('username').value.trim();

if(name.length<2){
alert('Please enter your name.');
return;
}

if(username.length<3){
alert('Please choose a username.');
return;
}

try{
await api('/api/profile',{
method:'POST',
body:JSON.stringify({name,username})
});

show('securityScreen');
}catch(e){
alert(e.message);
}
}

async function finishSetup(){
const pin=document.getElementById('securityPin').value.trim();
const recoveryEmail=document.getElementById('recoveryEmail').value.trim();

if(!/^[0-9]{6}$/.test(pin)){
alert('Create a 6-digit security PIN.');
return;
}

try{
await api('/api/security/two-step',{
method:'POST',
body:JSON.stringify({pin,recoveryEmail})
});

localStorage.setItem('gmessengerSetup','complete');
localStorage.setItem('gmessengerName',document.getElementById('profileName').value.trim());

show('appScreen');
await loadConversations();
}catch(e){
alert(e.message);
}
}

async function loadConversations(){
if(!token)return;

try{
const data=await api('/api/conversations');
const list=document.getElementById('chatList');

list.querySelectorAll('.real-chat').forEach(x=>x.remove());

const empty=document.getElementById('emptyChats');

if(!data.conversations.length){
empty.style.display='block';
return;
}

empty.style.display='none';

data.conversations.forEach(c=>{
if(!c.user)return;

const row=document.createElement('div');
row.className='chat real-chat';
row.dataset.name=c.user.name||c.user.username||c.user.phone||'User';

const name=c.user.name||c.user.username||c.user.phone||'User';
const initial=name.charAt(0).toUpperCase();
const preview=c.lastMessage?.text||'No messages yet';
const time=c.lastMessage?.created_at?
new Date(c.lastMessage.created_at).toLocaleTimeString([],{
hour:'2-digit',minute:'2-digit'
}):'';

row.innerHTML=
'<div class="avatar">'+escapeHtml(initial)+'</div>'+
'<div class="chat-info">'+
'<div class="chat-name">'+escapeHtml(name)+'</div>'+
'<div class="chat-preview">'+escapeHtml(preview)+'</div>'+
'</div>'+
'<div class="chat-right">'+escapeHtml(time)+'</div>';

row.onclick=()=>openConversation(c);
list.insertBefore(row,empty);
});
}catch(e){
console.warn('Conversation refresh:',e.message);
}
}

function openConversation(c){
currentConversation=c;
document.getElementById('contactName').textContent=
c.user.name||c.user.username||c.user.phone||'User';

document.getElementById('contactAvatar').textContent=
(c.user.name||c.user.username||'U').charAt(0).toUpperCase();

show('chatScreen');
loadMessages(c.id);
}

async function loadMessages(id){
try{
const data=await api('/api/conversations/'+id+'/messages');
const box=document.getElementById('messages');

box.innerHTML='';

data.messages.forEach(m=>{
const div=document.createElement('div');
div.className='msg '+(Number(m.sender_id)===Number(currentUser?.id)?'mine':'theirs');
div.textContent=m.text;
box.appendChild(div);
});

box.scrollTop=box.scrollHeight;

await api('/api/conversations/'+id+'/read',{method:'POST'});
}catch(e){
console.warn(e.message);
}
}

async function sendMessage(){
if(!currentConversation)return;

const input=document.getElementById('messageInput');
const text=input.value.trim();

if(!text)return;

input.value='';

try{
await api('/api/conversations/'+currentConversation.id+'/messages',{
method:'POST',
body:JSON.stringify({text})
});

await loadMessages(currentConversation.id);
}catch(e){
alert(e.message);
}
}

let typingTimer=null;

function sendTypingState(typing){
  if(!socket || !currentConversation) return;

  socket.emit('gm:typing', {
    conversationId: currentConversation.id,
    typing: Boolean(typing)
  });
}

function messageTyping(){
  sendTypingState(true);

  clearTimeout(typingTimer);

  typingTimer=setTimeout(()=>{
    sendTypingState(false);
  },1200);
}

function messageKey(e){
  if(e.key==='Enter'&&!e.shiftKey){
    e.preventDefault();
    clearTimeout(typingTimer);
    sendTypingState(false);
    sendMessage();
    return;
  }

  messageTyping();
}

function openGemma(){
show('gemmaScreen');
}

function sendGemma(){
const input=document.getElementById('gemmaInput');
const text=input.value.trim();

if(!text)return;

alert('Gemma AI connection can be connected to the AI service next.');
input.value='';
}

function filterChats(){
const q=document.getElementById('search').value.toLowerCase().trim();

document.querySelectorAll('.real-chat').forEach(row=>{
row.style.display=
!q||row.dataset.name.toLowerCase().includes(q)
?'flex':'none';
});
}

function escapeHtml(value){
return String(value)
.replace(/&/g,'&amp;')
.replace(/</g,'&lt;')
.replace(/>/g,'&gt;')
.replace(/"/g,'&quot;')
.replace(/'/g,'&#039;');
}

function logout(){
if(confirm('Log out of G Messenger?')){
localStorage.removeItem('gmessengerToken');
localStorage.removeItem('gmessengerName');
localStorage.removeItem('gmessengerSetup');
token='';
show('loginScreen');
}
}

/* Silent background refresh: no page reload and no visual animation. */
setInterval(()=>{
if(token&&document.getElementById('appScreen').classList.contains('active')){
loadConversations();
}
},5000);

startup();
</script>

</body>
</html>
