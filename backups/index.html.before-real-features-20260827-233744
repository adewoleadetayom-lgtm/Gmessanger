<script>
let authToken = null;
let currentPhone = '';

document.addEventListener('DOMContentLoaded', restoreStartupScreen);

function showScreen(id){
  document.querySelectorAll('.screen')
    .forEach(s => s.classList.remove('active'));

  const target = document.getElementById(id);

  if(target){
    target.classList.add('active');
  }
}

function restoreStartupScreen(){
  const savedName =
    localStorage.getItem('gmessengerName');

  const setupComplete =
    localStorage.getItem('gmessengerSetup') === 'complete';

  if(savedName && setupComplete){
    showScreen('appScreen');
  }else{
    showScreen('loginScreen');
  }
}



async function sendCode(){
  const phone =
    document.getElementById('phone').value.trim();

  const error =
    document.getElementById('loginError');

  if(phone.length < 7){
    error.style.display='block';
    return;
  }

  error.style.display='none';
  currentPhone=phone;

  try{
    const response = await fetch('/api/auth/register',{
      method:'POST',
      headers:{
        'Content-Type':'application/json'
      },
      body:JSON.stringify({phone})
    });

    const data=await response.json();

    if(!response.ok){
      throw new Error(data.error || 'Registration failed');
    }

    showScreen('verificationScreen');

  }catch(error){
    alert(error.message);
  }
}

async function verifyCode(){
  const code =
    document.getElementById('verificationCode')
      .value.trim();

  if(!/^[0-9]{6}$/.test(code)){
    alert('Enter the 6-digit verification code.');
    return;
  }

  try{
    const response=await fetch('/api/auth/verify',{
      method:'POST',
      headers:{
        'Content-Type':'application/json'
      },
      body:JSON.stringify({
        phone:currentPhone,
        code
      })
    });

    const data=await response.json();

    if(!response.ok){
      throw new Error(data.error || 'Verification failed');
    }

    authToken=data.token;

    if(data.user.profileComplete){
      showScreen('appScreen');
    }else{
      showScreen('profileScreen');
    }

  }catch(error){
    alert(error.message);
  }
}

async function createProfile(){
  const name =
    document.getElementById('profileName')
      .value.trim();

  const username =
    document.getElementById('username')
      .value.trim();

  if(name.length < 2){
    alert('Please enter your name.');
    return;
  }

  if(username.length < 3){
    alert('Please choose a username.');
    return;
  }

  try{
    const response=await fetch('/api/profile',{
      method:'POST',
      headers:{
        'Content-Type':'application/json',
        'Authorization':'Bearer '+authToken
      },
      body:JSON.stringify({
        name,
        username
      })
    });

    const data=await response.json();

    if(!response.ok){
      throw new Error(data.error || 'Profile update failed');
    }

    showScreen('securityScreen');

  }catch(error){
    alert(error.message);
  }
}

async function finishSetup(){
  const pin =
    document.getElementById('securityPin')
      .value.trim();

  const recoveryEmail =
    document.getElementById('recoveryEmail')
      .value.trim();

  if(!/^[0-9]{6}$/.test(pin)){
    alert('Create a 6-digit security PIN.');
    return;
  }

  try{
    const response=await fetch(
      '/api/security/two-step',{
        method:'POST',
        headers:{
          'Content-Type':'application/json',
          'Authorization':'Bearer '+authToken
        },
        body:JSON.stringify({
          pin,
          recoveryEmail
        })
      });

    const data=await response.json();

    if(!response.ok){
      throw new Error(
        data.error || 'Security setup failed'
      );
    }

    localStorage.setItem(
      'gmessengerSetup',
      'complete'
    );

    showScreen('appScreen');

  }catch(error){
    alert(error.message);
  }
}

function filterChats(value){
  const query=value.toLowerCase().trim();

  document.querySelectorAll(
    '#chatList .chat,#chatList .gemma-card'
  ).forEach(item=>{
    const name=
      (item.dataset.name || '').toLowerCase();

    item.style.display=
      !query || name.includes(query)
        ? 'flex'
        : 'none';
  });
}

function newChat(){
  alert(
    'Real contacts and messaging will be connected next.'
  );
}


function openSettings(){
  showScreen('settingsScreen');
}

function focusMessengerSearch(){
  showScreen('appScreen');

  setTimeout(() => {
    const search = document.querySelector('.search');

    if(search){
      search.focus();
      search.scrollIntoView({behavior:'smooth',block:'center'});
    }
  }, 100);
}


function openChat(name, initial, status){
  document.getElementById('chatContactName').textContent = name;
  document.getElementById('chatAvatar').textContent = initial || name.charAt(0).toUpperCase();
  document.getElementById('chatContactStatus').textContent = status || 'online';

  showScreen('chatScreen');

  setTimeout(() => {
    const messages = document.getElementById('chatMessages');
    if(messages){
      messages.scrollTop = messages.scrollHeight;
    }

    const input = document.getElementById('chatInput');
    if(input){
      input.focus();
    }
  }, 150);
}

function toggleAttachments(){
  const panel = document.getElementById('attachmentPanel');

  if(panel){
    panel.classList.toggle('open');
  }
}

function autoResizeChatInput(){
  const input = document.getElementById('chatInput');

  if(!input)return;

  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight,120) + 'px';
}

function handleChatEnter(event){
  if(event.key === 'Enter' && !event.shiftKey){
    event.preventDefault();
    sendChatMessage();
  }
}

function insertEmoji(){
  const input = document.getElementById('chatInput');

  if(!input)return;

  input.value += '😊';
  input.focus();
  autoResizeChatInput();
}

function sendChatMessage(){
  const input = document.getElementById('chatInput');
  const messages = document.getElementById('chatMessages');

  if(!input || !messages)return;

  const text = input.value.trim();

  if(!text)return;

  const wrapper = document.createElement('div');
  wrapper.className = 'gm-message outgoing';

  const bubble = document.createElement('div');
  bubble.className = 'gm-bubble';

  const messageText = document.createElement('span');
  messageText.className = 'gm-message-text';
  messageText.textContent = text;

  const meta = document.createElement('span');
  meta.className = 'gm-message-meta';
  meta.innerHTML = 'Now <span class="gm-checks">✓✓</span>';

  bubble.appendChild(messageText);
  bubble.appendChild(meta);
  wrapper.appendChild(bubble);
  messages.appendChild(wrapper);

  input.value = '';
  input.style.height = 'auto';

  messages.scrollTop = messages.scrollHeight;
}

function autoResizeGemmaInput(){
  const input = document.getElementById('gemmaInput');

  if(!input)return;

  input.style.height = 'auto';
  input.style.height = Math.min(input.scrollHeight,120) + 'px';
}

function insertGemmaEmoji(){
  const input = document.getElementById('gemmaInput');

  if(!input)return;

  input.value += '😊';
  input.focus();
  autoResizeGemmaInput();
}

function toggleGemmaAttachments(){
  alert('Gemma attachments will be connected next.');
}

function openGemma(){
  showScreen('gemmaScreen');
}

function sendGemma(){
  const input=
    document.getElementById('gemmaInput');

  const text=input.value.trim();

  if(!text)return;

  const messages=
    document.getElementById('gemmaMessages');

  const userMessage=document.createElement('div');

  userMessage.style.cssText=
    'max-width:80%;margin:8px 0 8px auto;background:#d9fdd3;padding:10px 13px;border-radius:15px 15px 3px 15px;line-height:1.4';

  userMessage.textContent=text;

  messages.appendChild(userMessage);

  input.value='';

  const reply=document.createElement('div');

  reply.style.cssText=
    'max-width:80%;margin:8px auto 8px 0;background:white;padding:10px 13px;border-radius:15px 15px 15px 3px;line-height:1.4;box-shadow:0 2px 7px rgba(0,0,0,.04)';

  reply.textContent=
    'Gemma AI connection will be enabled in the next stage.';

  messages.appendChild(reply);

  messages.scrollTop=messages.scrollHeight;
}


