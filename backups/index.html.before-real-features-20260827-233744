}

/* ================= SETTINGS ================= */

.settings-screen{
  flex-direction:column;
  background:#f0f2f5;
}

.settings-header{
  height:62px;
  display:flex;
  align-items:center;
  gap:12px;
  padding:0 14px;
  background:#075e54;
