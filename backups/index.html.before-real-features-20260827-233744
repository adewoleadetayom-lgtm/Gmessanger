}

@keyframes gmPulse{
  0%,100%{opacity:1}
  50%{opacity:.3}
}

.gm-recording-time{
  font-size:15px;
  font-weight:600;
  color:#222;
  min-width:48px;
}

.gm-recording-text{
  flex:1;
  color:#70777a;
  font-size:13px;
}

.gm-recording-cancel{
