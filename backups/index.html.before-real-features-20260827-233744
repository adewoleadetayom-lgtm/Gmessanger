                fill="currentColor">

                <path
                  d="M6.6 10.8a15.8 15.8 0 0 0 10.8 0l1.5-1.2a1.6 1.6 0 0 1 2.5 1.1l.3 2.6a1.7 1.7 0 0 1-1.2 1.8 18.8 18.8 0 0 1-16.9 0 1.7 1.7 0 0 1-1.2-1.8l.3-2.6a1.6 1.6 0 0 1 2.5-1.1z"/>

              </svg>

            </button>

          </div>

        </section>

        <div style="display:none">
          ${oldHTML}
        </div>

      </section>
    `;

    window.gmChatBack = gmBack;

    const input =
      document.getElementById(
        "gmComposeInput"
      );

    const mic =
      document.getElementById(
        "gmComposeMic"
      );

    const send =
      document.getElementById(
        "gmComposeSend"
      );

    if(input){

      input.addEventListener(
        "input",
        function(){

          const hasText =
            input.value.trim().length > 0;

          if(send){
            send.style.display =
              hasText ? "flex" : "none";
          }

          if(mic){
            mic.style.display =
              hasText ? "none" : "flex";
          }

          input.style.height = "45px";

          input.style.height =
            Math.min(
              input.scrollHeight,
              110
            ) + "px";

        }
      );

      input.addEventListener(
        "keydown",
        function(event){

          if(
            event.key === "Enter" &&
            !event.shiftKey
          ){
            event.preventDefault();
            gmSendText();
          }

        }
      );
    }

    const name =
      getCurrentName();

    const nameEl =
      document.getElementById(
        "gmChatHeadName"
      );

    if(nameEl){
      nameEl.textContent = name;
    }

    const avatar =
      document.getElementById(
        "gmChatHeadAvatar"
      );

    const src =
      getCurrentAvatar();

    if(avatar){

      if(src){

        avatar.innerHTML =
          '<img src="' +
          esc(src) +
          '" alt="">';

      }else{

        avatar.textContent =
          (name.charAt(0) || "G")
            .toUpperCase();

      }

    }

    scrollMessages();
  }

  window.gmRebuildChat2026 =
    function(){
      buildChat();
    };

  function watchChat(){
    const chat =
      getChatScreen();

    if(!chat){
      return;
    }

    if(
      chat.style.display !== "none" ||
      chat.classList.contains("active")
    ){
      buildChat();
    }
  }

  if(
    document.readyState === "loading"
  ){
    document.addEventListener(
      "DOMContentLoaded",
      watchChat
    );
  }else{
    watchChat();
  }

  const observer =
    new MutationObserver(
      function(){
        const chat =
          getChatScreen();

        if(
          chat &&
          !chat.dataset.gmChat2026 &&
          (
            chat.style.display !== "none" ||
            chat.classList.contains("active")
          )
        ){
          buildChat();
        }
      }
    );

  observer.observe(
    document.documentElement,
    {
      childList:true,
      subtree:true
    }
  );

})();

</script>
<!-- END GM-CHAT-2026-JS -->
</body>
</html>
