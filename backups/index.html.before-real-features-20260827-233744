                        gmEsc(chat.name) +
                      '</strong>' +

                      '<time>' +
                        gmEsc(chat.time) +
                      '</time>' +

                    '</span>' +

                    '<span class="gm-chat-line gm-preview">' +

                      '<span>' +
                        checks +
                        gmEsc(chat.preview) +
                      '</span>' +

                      unread +

                    '</span>' +

                  '</span>' +

                '</button>'
              );
            }
          ).join("");

        list
