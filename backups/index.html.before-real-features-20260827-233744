}

.gemma-input{
  display:flex;
  gap:8px;
  padding:10px;
  background:white;
  border-top:1px solid #e3e7ec;
}

.gemma-input input{
  flex:1;
  border:0;
  background:#f0f2f5;
  border-radius:22px;
  padding:12px 15px;
  outline:none;
}

.gemma-send{
  width:46px;
  height:46px;
  border:0;
  border-radius:50%;
  background:#087cff;
  color:white;
  font-size:19px;
}


/* ================= MODERN CHAT UI ================= */

.app-header{
  box-shadow:0 1px 0 rgba(0,0,0,.08);
}

.app-title{
  font-size:21px;
}

.header-actions{
  margin-left:auto;
}

.icon-btn{
  display:flex;
  align-items:center;
  justify-content:center;
}

.filters{
  scrollbar-width:none;
}

.filters::-webkit-scrollbar{
  display:none;
}

.chat-list{
  background:#f0f2f5;
}

.gemma-card,
.chat{
  min-height:76px;
}

.gemma-card{
  position:relative;
}

.gemma-card:active,
.chat:active{
  background:#f5f6f6;
}

.gemma-name,
.chat-name{
  font-size:16px;
