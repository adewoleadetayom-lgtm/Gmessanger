      </svg>
    </div>

    <h1>Create your profile</h1>

    <p class="subtitle">
      Choose the name and username people will see.
    </p>

    <div class="field">
      <label>Your name</label>
      <input id="profileName" type="text"
             placeholder="Your name">
    </div>

    <div class="field">
      <label>Username</label>
      <input id="username" type="text"
             placeholder="@username">
    </div>

    <button class="primary" onclick="createProfile()">
      Continue
    </button>
  </div>
</section>

<!-- SECURITY -->
<section id="securityScreen" class="screen login-screen">
  <div class="login-card">

    <div class="logo">
      <svg class="gm-logo-svg" viewBox="0 0 100 100"
           xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="50" r="47" fill="#087cff"/>
        <path d="M72 31C65 24 56 20 47 20C30 20 18 33 18 50C18 67 31 80 47 80C56 80 64 77 71 71L71 53L48 53L48 64L60 64C57 68 53 70 47 70C36 70 29 62 29 50C29 38 36 30 47 30C54 30 60 33 64 38Z" fill="white"/>
