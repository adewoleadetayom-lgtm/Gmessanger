(function(){

  function keepChatAtBottom(id){
    const box = document.getElementById(id);
    if(!box) return;

    requestAnimationFrame(function(){
      box.scrollTop = box.scrollHeight;
    });
  }

  window.addEventListener('resize', function(){
    const active = document.activeElement;

    if(active && (
      active.id === 'chatInput' ||
      active.id === 'gemmaInput'
    )){
      setTimeout(function(){
        keepChatAtBottom(
          active.id === 'gemmaInput'
            ? 'gemmaMessages'
            : 'chatMessages'
        );
      },120);
    }
  });

  document.addEventListener('click', function(e){
    const input = e.target.closest(
      '#chatInput, #gemmaInput'
    );

    if(input){
      setTimeout(function(){
        keepChatAtBottom(
          input.id === 'gemmaInput'
            ? 'gemmaMessages'
            : 'chatMessages'
        );
      },180);
    }
  });

})();

