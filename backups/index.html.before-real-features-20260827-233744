  if(window.__GM_CHAT_2026_READY){
    return;
  }

  window.__GM_CHAT_2026_READY = true;

  let recorder = null;
  let recordChunks = [];
  let recordStarted = 0;
  let recordTimer = null;
  let currentStream = null;

  function esc(v){
    return String(v ?? "").replace(/[&<>"']/g,function(m){
      return {
        "&":"&amp;",
        "<":"&lt;",
        ">":"&gt;",
        '"':"&quot;",
        "'":"&#039;"
      }[m];
    });
  }

  function getChatScreen(){
    return document.getElementById("chatScreen");
  }

  function getCurrentName(){
    const el =
      document.querySelector(
        "#chatScreen .chat-name,#chatScreen #chatTitle,#chatScreen .chat-title"
      );

    return el?.textContent?.trim() || "Chat";
  }

  function getCurrentAvatar(){
    const el =
      document.querySelector(
        "#chatScreen img.chat-avatar,#chatScreen img.avatar,#chatScreen .chat-avatar img"
      );

    return el?.getAttribute("src") || "";
  }

  function renderVoiceWave(){
    let out = "";

    const heights = [
      8,14,21,11,18,25,12,8,17,23,
      13,26,15,9,20,14,24,11,18,8,
      15,22,12,26,17,9,19,14,23,11
    ];

    heights.forEach(function(h){
      out += '<i style="height:'+h+'px"></i>';
    });

    return out;
  }

  function scrollMessages(){
    const box =
      document.getElementById("gmChat2026Messages");

    if(box){
      requestAnimationFrame(function(){
        box.scrollTop = box.scrollHeight;
      });
    }
  }

  function addVoiceMessage(blob,duration){
    const box =
      document.getElementById("gmChat2026Messages");

    if(!box){
      return;
    }

    const url = URL.createObjectURL(blob);

    const bubble =
      document.createElement("div");

    bubble.className =
      "gm-message-bubble gm-message-out";

    bubble.innerHTML =
      '<div class="gm-voice-bubble">' +
        '<button class="gm-voice-play" type="button" aria-label="Play voice message">' +
          '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">' +
            '<path d="M8 5v14l11-7z"/>' +
          '</svg>' +
        '</button>' +

        '<span class="gm-voice-wave">' +
          renderVoiceWave() +
        '</span>' +

        '<span class="gm-voice-duration">' +
          esc(duration) +
        '</span>' +
      '</div>' +

      '<div class="gm-message-meta">' +
        '<span>Now</span>' +
        '<span class="gm-message-checks">✓✓</span>' +
      '</div>';

    const audio =
      document.createElement("audio");

    audio.preload = "metadata";
    audio.src = url;

    const play =
      bubble.querySelector(".gm-voice-play");

    play.addEventListener("click",function(){
      if(audio.paused){
        audio.play().catch(function(){});
        play.innerHTML =
          '<svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor">' +
            '<path d="M7 5h4v14H7zM13 5h4v14h-4z"/>' +
          '</svg>';
      }else{
        audio.pause();
        play.innerHTML =
          '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">' +
            '<path d="M8 5v14l11-7z"/>' +
          '</svg>';
      }
    });

    audio.addEventListener("ended",function(){
      play.innerHTML =
        '<svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">' +
          '<path d="M8 5v14l11-7z"/>' +
        '</svg>';
    });

    bubble.appendChild(audio);
    box.appendChild(bubble);

    scrollMessages();
  }

  function formatDuration(seconds){
    const s =
      Math.max(0,Math.floor(seconds));

    const m =
      Math.floor(s / 60);

    const r =
      s % 60;

    return (
      String(m).padStart(2,"0") +
      ":" +
      String(r).padStart(2,"0")
    );
  }

  function showRecordingBar(){
    const bar =
      document.getElementById("gmRecordingBar");

    if(bar){
      bar.classList.add("active");
    }
  }

  function hideRecordingBar(){
    const bar =
      document.getElementById("gmRecordingBar");

    if(bar){
      bar.classList.remove("active");
    }
  }

  function updateRecordingTime(){
    const el =
      document.getElementById("gmRecordingTime");

    if(el){
      el.textContent =
        formatDuration(
          (Date.now() - recordStarted) / 1000
        );
    }
  }

  async function startRecording(){
    if(recorder){
      return;
    }

    if(
      !navigator.mediaDevices ||
      !navigator.mediaDevices.getUserMedia
    ){
      alert(
        "Microphone recording is not available in this WebView."
      );
      return;
    }

    try{
      currentStream =
        await navigator.mediaDevices.getUserMedia({
          audio:true
        });

      const options = {};

      if(
        typeof MediaRecorder !== "undefined" &&
        MediaRecorder.isTypeSupported &&
        MediaRecorder.isTypeSupported("audio/webm;codecs=opus")
      ){
        options.mimeType =
          "audio/webm;codecs=opus";
      }

      recorder =
        new MediaRecorder(
          currentStream,
          options
        );

      recordChunks = [];
      recordStarted = Date.now();

      recorder.ondataavailable =
        function(event){
          if(event.data && event.data.size){
            recordChunks.push(event.data);
          }
        };

      recorder.onstop =
        function(){

          clearInterval(recordTimer);
          recordTimer = null;

          const duration =
            (Date.now() - recordStarted) / 1000;

          const blob =
            new Blob(
              recordChunks,
              {
                type:
                  recorder.mimeType ||
                  "audio/webm"
              }
            );

          if(blob.size > 0){
            addVoiceMessage(
              blob,
              formatDuration(duration)
            );
          }

          if(currentStream){
            currentStream
              .getTracks()
              .forEach(function(track){
                track.stop();
              });
          }

          currentStream = null;
          recorder = null;
          recordChunks = [];

          hideRecordingBar();
        };

      recorder.start();

      showRecordingBar();

      updateRecordingTime();

      recordTimer =
        setInterval(
          updateRecordingTime,
          250
        );

    }catch(error){
      recorder = null;

      if(currentStream){
        currentStream
          .getTracks()
          .forEach(function(track){
            track.stop();
          });
      }

      currentStream = null;

      alert(
        "Microphone permission is required for voice messages."
      );
    }
  }

  function stopRecording(){
    if(
      recorder &&
      recorder.state !== "inactive"
    ){
      recorder.stop();
    }
  }

  function cancelRecording(){
    if(
      recorder &&
      recorder.state !== "inactive"
    ){
      recorder.onstop = function(){

        clearInterval(recordTimer);
        recordTimer = null;

        if(currentStream){
          currentStream
            .getTracks()
            .forEach(function(track){
              track.stop();
            });
        }

        currentStream = null;
        recorder = null;
        recordChunks = [];

        hideRecordingBar();
      };

      recorder.stop();
    }else{
      hideRecordingBar();
    }
  }

  window.gmStartVoiceMessage =
    startRecording;

  window.gmStopVoiceMessage =
    stopRecording;

  window.gmCancelVoiceMessage =
