<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no">
<meta name="theme-color" content="#075e54">
<title>G Messenger</title>

<style>
*{box-sizing:border-box}

:root{
  --green:#075e54;
  --green2:#128c7e;
  --blue:#087cff;
  --bg:#f0f2f5;
  --card:#fff;
  --text:#111b21;
  --muted:#667781;
  --line:#e9edef;
}

body{
  margin:0;
  font-family:Arial,Helvetica,sans-serif;
  background:var(--bg);
  color:var(--text);
}

button,input{
  font:inherit;
}

.screen{
  min-height:100vh;
  display:none;
}

.screen.active{
  display:flex;
}

/* ================= LOGIN ================= */

.login-screen{
  align-items:center;
  justify-content:center;
  padding:22px;
  background:linear-gradient(180deg,#f7fbff,#eef5ff);
}

.login-card{
  width:100%;
  max-width:430px;
  background:white;
  border-radius:28px;
  padding:30px 24px;
  box-shadow:0 12px 40px rgba(0,0,0,.10);
  text-align:center;
}

.logo{
  width:88px;
  height:88px;
  margin:0 auto 18px;
  padding:4px;
  border-radius:27px;
  background:linear-gradient(145deg,#fff,#e9f3ff);
  box-shadow:0 12px 30px rgba(8,124,255,.20);
}

.gm-logo-svg{
  width:100%;
  height:100%;
  display:block;
}

.login-card h1{
  margin:7px 0;
  color:var(--blue);
}

.subtitle{
  color:var(--muted);
  line-height:1.5;
}

.field{
  text-align:left;
  margin:18px 0;
}

.field label{
  display:block;
  font-size:14px;
  font-weight:bold;
  margin-bottom:7px;
}

.field input{
  width:100%;
  border:1px solid #d5dde5;
  border-radius:14px;
  padding:14px;
  outline:none;
}

.field input:focus{
  border-color:var(--blue);
  box-shadow:0 0 0 3px rgba(8,124,255,.10);
}

.primary{
  width:100%;
  border:0;
  border-radius:14px;
  padding:14px;
  background:var(--blue);
  color:white;
  font-weight:bold;
}

.secondary{
  width:100%;
  border:1px solid #d5dde5;
  border-radius:14px;
  padding:13px;
  background:white;
  color:var(--blue);
  font-weight:bold;
  margin-top:10px;
}

.small{
  font-size:12px;
  color:#8696a0;
  line-height:1.5;
  margin-top:16px;
}

/* ================= MAIN APP ================= */

.app{
  flex-direction:column;
  background:var(--bg);
}

.app-header{
  background:var(--green);
  color:white;
  padding:12px 15px 9px;
}

.header-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
}

.app-title{
  font-size:22px;
  font-weight:bold;
  letter-spacing:-.3px;
}

.header-actions{
  display:flex;
  gap:5px;
}

.icon-btn{
  width:42px;
  height:42px;
  border:0;
  border-radius:50%;
  background:transparent;
  color:white;
  font-size:20px;
}

.icon-btn:active{
  background:rgba(255,255,255,.15);
}

.search-wrap{
  padding:9px 12px;
  background:var(--green);
}

.search{
  width:100%;
  border:0;
  border-radius:22px;
  padding:11px 16px;
  outline:none;
  background:white;
}

.filters{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding:10px 12px;
  background:white;
  border-bottom:1px solid var(--line);
}

.filter{
  border:0;
  border-radius:18px;
  padding:7px 14px;
  background:#f0f2f5;
  color:var(--muted);
  white-space:nowrap;
  font-size:13px;
  font-weight:bold;
}

.filter.active{
  background:#d9fdd3;
  color:#075e54;
}

.chat-list{
  flex:1;
  overflow:auto;
}

.gemma-card{
  display:flex;
  align-items:center;
  padding:14px 15px;
  background:white;
  border-bottom:1px solid var(--line);
  cursor:pointer;
}

.gemma-logo{
  width:55px;
  height:55px;
  border-radius:50%;
  background:linear-gradient(145deg,#087cff,#004fe0);
  display:flex;
  align-items:center;
  justify-content:center;
  margin-right:13px;
  box-shadow:0 5px 14px rgba(8,124,255,.25);
  flex-shrink:0;
}

.gemma-logo svg{
  width:42px;
  height:42px;
}

.gemma-info{
  flex:1;
}

.gemma-name{
  font-size:16px;
  font-weight:bold;
}

.gemma-sub{
  margin-top:4px;
  color:var(--muted);
  font-size:13px;
}

.ai-badge{
  color:#087cff;
  font-size:11px;
  font-weight:bold;
}

.chat{
  display:flex;
  align-items:center;
  padding:13px 15px;
  background:white;
  border-bottom:1px solid var(--line);
}

.avatar{
  width:54px;
  height:54px;
  border-radius:50%;
  background:#d9fdd3;
  color:#075e54;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  font-size:20px;
  margin-right:13px;
  flex-shrink:0;
}

.chat-info{
  flex:1;
  min-width:0;
}

.chat-name{
  font-weight:bold;
}

.chat-preview{
  color:var(--muted);
  font-size:13px;
  margin-top:5px;
  white-space:nowrap;
  overflow:hidden;
  text-overflow:ellipsis;
}

.chat-right{
  text-align:right;
  margin-left:8px;
}

.time{
  color:var(--muted);
  font-size:11px;
}

.unread{
  margin-top:5px;
  display:inline-flex;
  min-width:20px;
  height:20px;
  padding:0 6px;
  border-radius:12px;
  align-items:center;
  justify-content:center;
  background:#25d366;
  color:white;
  font-size:11px;
  font-weight:bold;
}

.bottom-nav{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  background:white;
  border-top:1px solid #dfe5e7;
  padding-bottom:3px;
}

.bottom-nav button{
  border:0;
  background:white;
  padding:9px 2px 7px;
  color:var(--muted);
  font-size:12px;
}

.bottom-nav button span{
  display:block;
  font-size:20px;
  margin-bottom:3px;
}

.bottom-nav button.active{
  color:#075e54;
  font-weight:bold;
}

.fab{
  position:fixed;
  right:19px;
  bottom:70px;
  width:57px;
  height:57px;
  border:0;
  border-radius:50%;
  background:#087cff;
  color:white;
  font-size:27px;
  box-shadow:0 7px 20px rgba(8,124,255,.30);
}

.empty{
  padding:50px 25px;
  text-align:center;
  color:var(--muted);
}

/* ================= GEMMA ================= */

.gemma-screen{
  flex-direction:column;
  background:#f5f7fb;
}

.gemma-header{
  background:linear-gradient(135deg,#087cff,#005bea);
  color:white;
  padding:12px 14px;
  display:flex;
  align-items:center;
