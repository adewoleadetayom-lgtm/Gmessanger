  color:#fff;
}

.gm-compose-send{
  display:none;
  background:#20a966;
  color:#fff;
}

.gm-recording-bar{
  position:absolute;
  left:8px;
  right:8px;
  bottom:74px;
  min-height:57px;
  display:none;
  align-items:center;
  gap:10px;
  padding:7px 10px;
