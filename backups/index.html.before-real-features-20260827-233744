/* ============================================================
   G MESSENGER — 2026 ANDROID MOBILE CHAT EXPERIENCE
   ============================================================ */

html,
body{
  width:100%;
  height:100%;
  margin:0;
  padding:0;
  overflow:hidden;
  -webkit-text-size-adjust:100%;
  text-size-adjust:100%;
}

*{
  -webkit-tap-highlight-color:transparent;
  box-sizing:border-box;
}

button,
textarea,
input{
  font-family:inherit;
}

button{
  touch-action:manipulation;
}

/* ---------------- CHAT SCREEN ---------------- */

.gm-chat-screen{
  position:fixed;
  inset:0;
  width:100%;
  height:100dvh;
  min-height:100dvh;
  display:flex;
  flex-direction:column;
  overflow:hidden;
  background:#efeae2;
}

/* ---------------- CHAT HEADER ---------------- */

.gm-chat-header{
  position:relative;
  z-index:20;
  width:100%;
  min-height:64px;
  height:64px;
  padding:
    max(5px, env(safe-area-inset-top))
    6px
    5px
    6px;
  display:flex;
  align-items:center;
  gap:5px;
  background:#075e54;
  color:#fff;
  box-shadow:0 1px 3px rgba(0,0,0,.20);
  flex-shrink:0;
}

.gm-chat-back,
.gm-chat-action{
  width:44px;
  height:44px;
  min-width:44px;
  min-height:44px;
  padding:0;
  border:0;
  border-radius:50%;
  background:transparent;
  color:#fff;
  display:flex;
  align-items:center;
  justify-content:center;
}

.gm-chat-back:active,
.gm-chat-action:active{
  background:rgba(255,255,255,.16);
  transform:scale(.95);
}

.gm-chat-avatar{
  width:43px;
  height:43px;
  min-width:43px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#d9fdd3;
  color:#075e54;
  font-size:18px;
  font-weight:700;
  overflow:hidden;
}

.gm-chat-contact{
  flex:1;
  min-width:0;
  padding-left:2px;
  overflow:hidden;
}

.gm-chat-contact-name{
  width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  font-size:16px;
  line-height:20px;
  font-weight:600;
}

.gm-chat-status{
  width:100%;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
  margin-top:1px;
  font-size:11px;
  line-height:15px;
  opacity:.86;
}

.gm-chat-header-actions{
  display:flex;
  align-items:center;
  gap:0;
}

/* ---------------- CHAT BACKGROUND ---------------- */

.gm-chat-messages,
.gemma-messages{
  flex:1;
  min-height:0;
  width:100%;
  overflow-y:auto;
  overflow-x:hidden;
  overscroll-behavior-y:contain;
  -webkit-overflow-scrolling:touch;
  scroll-behavior:smooth;
  padding:
    10px
    8px
    16px;
  background-color:#efeae2;
  background-image:
    radial-gradient(
      rgba(84,72,63,.055) 1px,
      transparent 1px
    );
  background-size:18px 18px;
}

/* ---------------- DATE DIVIDER ---------------- */

.gm-date-divider{
  width:max-content;
  max-width:90%;
  margin:5px auto 13px;
  padding:6px 12px;
  border-radius:8px;
  background:rgba(255,255,255,.90);
  color:#667781;
  font-size:10px;
  font-weight:600;
  letter-spacing:.2px;
  box-shadow:0 1px 2px rgba(0,0,0,.10);
}

/* ---------------- MESSAGE ROW ---------------- */

.gm-message{
  width:100%;
  display:flex;
