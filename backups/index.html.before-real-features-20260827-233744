                  );

                }
              );

            }
          );
      }

      const unreadCount =
        (window.__gmHomeChats || [])
          .filter(function(c){
            return c.unread;
          }).length;

      const all =
        document.getElementById(
          "gmAllCount"
        );

      const unread =
        document.getElementById(
          "gmUnreadCount"
        );

      const badge =
        document.getElementById(
          "gmNavUnread"
        );

      if(all){
        all.textContent =
          (window.__gmHomeChats || []).length
          ? (window.__gmHomeChats || []).length
          : "";
      }

      if(unread){
        unread.textContent =
          unreadCount
          ? unreadCount
          : "";
      }

      if(badge){
        badge.textContent =
          unreadCount
          ? unreadCount
          : "";
      }
    };

    window.gmFilterChats =
      function(filter,button){

        window.__gmHomeFilter = filter;

        document
          .querySelectorAll(".gm-filter")
          .forEach(function(b){
            b.classList.remove("active");
          });

        if(button){
          button.classList.add("active");
        }

        window.gmRenderChats();
      };

    window.gmClearSearch =
      function(){

        const input =
          document.getElementById(
