}

.settings-header h2{
  margin:0;
  font-size:20px;
}

.settings-back{
  width:42px;
  height:42px;
  display:flex;
  align-items:center;
  justify-content:center;
  border:0;
  background:transparent;
  color:white;
  border-radius:50%;
}

.settings-back:active{
  background:rgba(255,255,255,.15);
}

.settings-content{
  flex:1;
  overflow:auto;
