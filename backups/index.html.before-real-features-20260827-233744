            if(q && !hay.includes(q)){
              return false;
            }

            if(
              filter === "unread" &&
              !chat.unread
            ){
              return false;
            }

            if(
              filter === "favorites" &&
              !/favorite|star|★/i.test(hay)
            ){
              return false;
            }

            if(
              filter === "groups" &&
              !/group|community|team|church|class/i.test(hay)
