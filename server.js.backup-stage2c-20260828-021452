/* ============================================================
   G MESSENGER — REALTIME STAGE 1
   ============================================================ */

const onlineUsers = new Map();

function emitToUser(userId, event, data) {
  const sockets = onlineUsers.get(Number(userId));
  if (!sockets) return;

  for (const socketId of sockets) {
    io.to(socketId).emit(event, data);
  }
}

io.on('connection', (socket) => {

  socket.on('gm:authenticate', (token) => {
    try {
      const user = jwt.verify(String(token || ''), JWT_SECRET);
      const userId = Number(user.id);

      if (!userId) return;

      socket.userId = userId;

      if (!onlineUsers.has(userId)) {
        onlineUsers.set(userId, new Set());
      }

      onlineUsers.get(userId).add(socket.id);

      socket.emit('gm:authenticated', { userId });

      io.emit('gm:user-online', { userId });

    } catch {
      socket.disconnect(true);
    }
  });

  socket.on('gm:typing', ({ conversationId, typing }) => {
    if (!socket.userId || !conversationId) return;

    const conversations = readConversations();
    const conversation = conversations.find(c =>
      Number(c.id) === Number(conversationId) &&
      (
        Number(c.user1) === Number(socket.userId) ||
        Number(c.user2) === Number(socket.userId)
      )
    );

    if (!conversation) return;

    const otherUserId =
      Number(conversation.user1) === Number(socket.userId)
        ? Number(conversation.user2)
        : Number(conversation.user1);

    emitToUser(otherUserId, 'gm:typing', {
      conversationId: Number(conversationId),
      userId: Number(socket.userId),
      typing: Boolean(typing)
    });
  });

  socket.on('disconnect', () => {
    if (!socket.userId) return;

    const userId = Number(socket.userId);
    const sockets = onlineUsers.get(userId);

    if (!sockets) return;

    sockets.delete(socket.id);

    if (sockets.size === 0) {
      onlineUsers.delete(userId);
      io.emit('gm:user-offline', { userId });
    }
  });
});

